# Copy to .env and fill in. Never commit .env.

# --- Model: pick one ---------------------------------------------------------
# Claude direct (https://console.anthropic.com), optional
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Chalk AI Router (free at HackHarvard). Use the key Chalk gave you for the event, with Chalk's
# HackHarvard environment and model. If both Chalk and Anthropic are set, Chalk is used.
CHALK_ROUTER_API_KEY=
CHALK_ENV_ID=clkdcdaf84e
CHALK_MODEL=openai/gpt-6.1-sol
# CHALK_API_HOST=https://api.chalk.ai
# For Claude through your own Chalk environment instead: your env id, CHALK_MODEL=anthropic/claude-sonnet-5-5

# Which model to use: chalk | anthropic | mock. Empty = Chalk if its key + env id are set, else Claude, else mock.
# A provider whose key is missing is skipped, so the app always starts.
# LLM_MODE=anthropic

# --- Factory Droid (Study Builder) ---------------------------------------------
# Key from https://app.factory.ai/settings/api-keys ; also install the droid CLI and droid-sdk[mcp]
FACTORY_API_KEY=
# FACTORY_MODEL=                       # optional; omit for your Factory default

# --- Photon (https://app.beta.photon.codes): project ID starts with pho_prj_ ---------
PHOTON_API_KEY=
PHOTON_PROJECT_ID=
PHOTON_PLATFORM=imessage
# PHOTON_THREAD_REPLIES=1

# --- App ---------------------------------------------------------------------
# medical (default): hold replies on medical turns; all: hold every reply; none: never hold
APPROVAL_MODE=medical
STUDY_TZ=America/New_York
PORT=8000
# HOST=0.0.0.0              # to open the dashboard from another device on your network
# DASHBOARD_TOKEN=change-me # then open http://host:8000/?token=change-me
